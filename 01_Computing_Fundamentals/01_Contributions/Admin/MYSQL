-- QUERY 1: List every role

SELECT *
FROM EmployeeRoles;


-- QUERY 2: Role names and budgets

SELECT RoleName, BudgetPerUnit
FROM EmployeeRoles;


-- QUERY 3: Higher-budget roles

SELECT RoleName, BudgetPerUnit
FROM EmployeeRoles
WHERE BudgetPerUnit > 1000;


-- QUERY 4: Roles by team size

SELECT RoleName, StaffCount
FROM EmployeeRoles
ORDER BY StaffCount DESC;


-- QUERY 5: Find one build's items

SELECT *
FROM BuildItems
WHERE BuildID = 1;


-- QUERY 6: Count the items in build 1

SELECT COUNT(*) AS NumberOfItems
FROM BuildItems
WHERE BuildID = 1;


-- QUERY 7: Total cost of build 1

SELECT SUM(Cost) AS TotalBuildCost
FROM BuildItems
WHERE BuildID = 1;


-- QUERY 8: Cost of every build, most expensive first

SELECT BuildID, SUM(Cost) AS TotalBuildCost
FROM BuildItems
GROUP BY BuildID
ORDER BY TotalBuildCost DESC;


-- QUERY 9: Which role is each build for?

SELECT WorkstationBuilds.BuildName, EmployeeRoles.RoleName
FROM WorkstationBuilds
JOIN EmployeeRoles
ON WorkstationBuilds.RoleID = EmployeeRoles.RoleID;


-- QUERY 10: Items with their build and role

SELECT 
    BuildItems.ItemName,
    WorkstationBuilds.BuildName,
    EmployeeRoles.RoleName
FROM BuildItems
JOIN WorkstationBuilds
    ON BuildItems.BuildID = WorkstationBuilds.BuildID
JOIN EmployeeRoles
    ON WorkstationBuilds.RoleID = EmployeeRoles.RoleID;


    -- QUERY 11: Total hardware spend per role

SELECT 
EmployeeRoles.RoleName,
SUM(BuildItems.Cost) AS TotalHardwareCost
FROM EmployeeRoles
JOIN WorkstationBuilds
ON EmployeeRoles.RoleID = WorkstationBuilds.RoleID
JOIN BuildItems
ON WorkstationBuilds.BuildID = BuildItems.BuildID
GROUP BY EmployeeRoles.RoleName;
