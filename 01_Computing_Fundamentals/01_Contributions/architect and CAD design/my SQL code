-- ============================================================
-- 1. REMOVE EXISTING TABLES
-- This allows the script to be run again.
-- ============================================================

DROP TABLE IF EXISTS Recommendations;
DROP TABLE IF EXISTS BuildItems;
DROP TABLE IF EXISTS WorkstationBuilds;
DROP TABLE IF EXISTS EmployeeRoles;


-- ============================================================
-- 2. CREATE EmployeeRoles
-- ============================================================

CREATE TABLE EmployeeRoles (
    RoleID INT PRIMARY KEY,
    RoleName VARCHAR(50) NOT NULL,
    StaffCount INT NOT NULL,
    Tasks VARCHAR(255) NOT NULL,
    PerformanceNeed VARCHAR(100) NOT NULL,
    BudgetPerUnit DECIMAL(8,2) NOT NULL
);


-- ============================================================
-- 3. CREATE WorkstationBuilds
-- ============================================================

CREATE TABLE WorkstationBuilds (
    BuildID INT PRIMARY KEY,
    RoleID INT NOT NULL,
    BuildName VARCHAR(100) NOT NULL,
    Source VARCHAR(50) NOT NULL,

    CONSTRAINT FK_Build_Role
        FOREIGN KEY (RoleID)
        REFERENCES EmployeeRoles(RoleID)
);


-- ============================================================
-- 4. CREATE BuildItems
-- ============================================================

CREATE TABLE BuildItems (
    ItemID INT PRIMARY KEY,
    BuildID INT NOT NULL,
    HardwareCategory VARCHAR(50) NOT NULL,
    ItemName VARCHAR(100) NOT NULL,
    Specification VARCHAR(150) NOT NULL,
    Cost DECIMAL(8,2) NOT NULL,

    CONSTRAINT FK_Item_Build
        FOREIGN KEY (BuildID)
        REFERENCES WorkstationBuilds(BuildID)
);


-- ============================================================
-- 5. CREATE Recommendations
-- ============================================================

CREATE TABLE Recommendations (
    RecommendationID INT PRIMARY KEY,
    RoleID INT NOT NULL,
    Justification TEXT NOT NULL,
    Compromise TEXT NOT NULL,
    Approved BOOLEAN NOT NULL,
    EthicalNotes TEXT NOT NULL,

    CONSTRAINT FK_Recommendation_Role
        FOREIGN KEY (RoleID)
        REFERENCES EmployeeRoles(RoleID)
);


