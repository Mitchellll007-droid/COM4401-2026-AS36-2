-- ============================================================
-- ============================================================
-- PART A - READING SINGLE TABLES
-- ============================================================
-- ============================================================


-- ============================================================
-- QUERY 1
-- List every role
--
-- Brief requirement:
-- Show all columns for every row in EmployeeRoles.
-- ============================================================

SELECT *
FROM EmployeeRoles;


-- ============================================================
-- QUERY 2
-- Just the names and budgets
--
-- Brief requirement:
-- Show only the role name and budget per workstation.
-- ============================================================

SELECT
    RoleName,
    BudgetPerUnit
FROM EmployeeRoles;


-- ============================================================
-- QUERY 3
-- The higher-budget roles
--
-- Brief requirement:
-- Show roles with a budget over £1000 per workstation.
-- ============================================================

SELECT
    RoleName,
    BudgetPerUnit
FROM EmployeeRoles
WHERE BudgetPerUnit > 1000;


-- ============================================================
-- QUERY 4
-- Roles by team size
--
-- Brief requirement:
-- Show roles and staff numbers, largest teams first.
-- ============================================================

SELECT
    RoleName,
    StaffCount
FROM EmployeeRoles
ORDER BY StaffCount DESC;


-- ============================================================
-- QUERY 5
-- Find one build's items
--
-- Brief requirement:
-- Show every component/peripheral belonging to build number 1.
-- ============================================================

SELECT *
FROM BuildItems
WHERE BuildID = 1;


-- ============================================================
-- QUERY 6
-- Count the items in a build
--
-- Brief requirement:
-- Count how many items are recorded for build number 1.
-- ============================================================

SELECT
    COUNT(*) AS NumberOfItems
FROM BuildItems
WHERE BuildID = 1;


-- ============================================================
-- ============================================================
-- PART B - TOTALS & SUMMARIES
-- ============================================================
-- ============================================================


-- ============================================================
-- QUERY 7
-- Total cost of one build
--
-- Brief requirement:
-- Add the cost of every item in build number 1.
-- ============================================================

SELECT
    BuildID,
    SUM(Cost) AS TotalHardwareCost
FROM BuildItems
WHERE BuildID = 1
GROUP BY BuildID;


-- ============================================================
-- QUERY 8
-- Cost of every build
--
-- Brief requirement:
-- Show total cost of each build, most expensive first.
-- ============================================================

SELECT
    BuildID,
    SUM(Cost) AS TotalHardwareCost
FROM BuildItems
GROUP BY BuildID
ORDER BY TotalHardwareCost DESC;


-- ============================================================
-- ============================================================
-- PART C - ACROSS TABLES WITH JOINS
-- ============================================================
-- ============================================================


-- ============================================================
-- QUERY 9
-- Which role is each build for?
--
-- Brief requirement:
-- Show each build name next to the role it belongs to.
-- ============================================================

SELECT
    WorkstationBuilds.BuildID,
    WorkstationBuilds.BuildName,
    EmployeeRoles.RoleName
FROM WorkstationBuilds
INNER JOIN EmployeeRoles
    ON WorkstationBuilds.RoleID = EmployeeRoles.RoleID;


-- ============================================================
-- QUERY 10
-- Items with their build and role
--
-- Brief requirement:
-- Show item name, build and role.
-- This links three tables together.
-- ============================================================

SELECT
    BuildItems.ItemName,
    WorkstationBuilds.BuildName,
    EmployeeRoles.RoleName
FROM BuildItems
INNER JOIN WorkstationBuilds
    ON BuildItems.BuildID = WorkstationBuilds.BuildID
INNER JOIN EmployeeRoles
    ON WorkstationBuilds.RoleID = EmployeeRoles.RoleID;


-- ============================================================
-- QUERY 11
-- Spend per role - CHALLENGE QUERY
--
-- Brief requirement:
-- Show total hardware cost grouped by role name.
-- Combines JOIN + SUM + GROUP BY.
-- ============================================================

SELECT
    EmployeeRoles.RoleName,
    SUM(BuildItems.Cost) AS TotalHardwareCost
FROM EmployeeRoles
INNER JOIN WorkstationBuilds
    ON EmployeeRoles.RoleID = WorkstationBuilds.RoleID
INNER JOIN BuildItems
    ON WorkstationBuilds.BuildID = BuildItems.BuildID
GROUP BY EmployeeRoles.RoleName;


